+        ~JuceVST3Editor() override = default; // NOLINT
+
+        // Forward command-key shortcuts that VST3 hosts may otherwise consume
+        // before they reach the embedded editor.
+        tresult PLUGIN_API onKeyDown (char16 key, int16 keyCode, int16 modifiers) override
+        {
+            if (component == nullptr)
+                return kResultFalse;
+
+            auto* peer = component->getPeer();
+            if (peer == nullptr || ! component->hasKeyboardFocus (true))
+                return kResultFalse;
+
+            const auto mods = vst3ModifiersToJuce (modifiers);
+
+            if ((mods.getRawFlags() & ModifierKeys::commandModifier) == 0)
+                return kResultFalse;
+
+            // Command shortcuts are character keys, so keyCode is zero.
+            if (keyCode != 0 || key == 0)
+                return kResultFalse;
+
+            auto juceKeyCode = (int) key;
+            if (juceKeyCode >= 'A' && juceKeyCode <= 'Z')
+                juceKeyCode += ('a' - 'A');
+
+            const KeyPress keyPress (juceKeyCode, mods, (juce_wchar) key);
+            return peer->handleKeyPress (keyPress) ? kResultTrue : kResultFalse;
+        }
+
+        tresult PLUGIN_API onKeyUp (char16 key, int16 keyCode, int16 modifiers) override
+        {
+            const auto mods = vst3ModifiersToJuce (modifiers);
+
+            if ((mods.getRawFlags() & ModifierKeys::commandModifier) != 0
+                && keyCode == 0 && key != 0)
+                return kResultTrue;
+
+            return kResultFalse;
+        }
+
+        static ModifierKeys vst3ModifiersToJuce (int16 modifiers) noexcept
+        {
+            constexpr int vstShiftKey     = 1 << 0;
+            constexpr int vstAlternateKey = 1 << 1;
+            constexpr int vstCommandKey   = 1 << 2;
+            constexpr int vstControlKey   = 1 << 3;
+
+            int flags = 0;
+            if (modifiers & vstShiftKey)     flags |= ModifierKeys::shiftModifier;
+            if (modifiers & vstAlternateKey) flags |= ModifierKeys::altModifier;
+            if (modifiers & vstCommandKey)   flags |= ModifierKeys::commandModifier;
+            if (modifiers & vstControlKey)   flags |= ModifierKeys::ctrlModifier;
+
+            return ModifierKeys (flags);
+        }
